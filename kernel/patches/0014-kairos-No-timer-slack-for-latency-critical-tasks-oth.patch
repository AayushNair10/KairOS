From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Aayush Nair <aayushnair204@gmail.com>
Date: Wed, 25 Nov 2026 02:58:46 -0500
Subject: [PATCH] kairos: No timer slack for latency-critical tasks' other
 timed waits

The previous patch gave Kairos latency-critical tasks no timer slack in
sleeps and in poll, select and epoll timeouts. The other timed waits
read the task's slack directly: futex waits (futex_wait(),
futex_wait_requeue_pi(): pthread_cond_timedwait() and the like),
sigtimedwait(), semtimedop(), io_getevents() and the kernel's
wait_event_hrtimeout(). Use kairos_timer_slack() in them too, so that a
latency-critical task's timed wait ends on time whichever call made it.

wait.h includes linux/kairos_class.h for the macro; without
CONFIG_KAIROS_TIMERS it is the task's own slack, as before.

Signed-off-by: Aayush Nair <aayushnair204@gmail.com>
---
 fs/aio.c                | 3 ++-
 include/linux/wait.h    | 3 ++-
 ipc/sem.c               | 3 ++-
 kernel/futex/requeue.c  | 3 ++-
 kernel/futex/waitwake.c | 3 ++-
 kernel/signal.c         | 3 ++-
 6 files changed, 12 insertions(+), 6 deletions(-)

diff --git a/fs/aio.c b/fs/aio.c
index a07bdd1aaaa6097905a344cda16ae43aba0aca52..383e314633649ecf9ec3c6153efb664fc9da36a1 100644
--- a/fs/aio.c
+++ b/fs/aio.c
@@ -32,6 +32,7 @@
 #include <linux/timer.h>
 #include <linux/aio.h>
 #include <linux/highmem.h>
+#include <linux/kairos_class.h>
 #include <linux/workqueue.h>
 #include <linux/security.h>
 #include <linux/eventfd.h>
@@ -1336,7 +1337,7 @@ static long read_events(struct kioctx *ctx, long min_nr, long nr,
 
 	hrtimer_setup_sleeper_on_stack(&t, CLOCK_MONOTONIC, HRTIMER_MODE_REL);
 	if (until != KTIME_MAX) {
-		hrtimer_set_expires_range_ns(&t.timer, until, current->timer_slack_ns);
+		hrtimer_set_expires_range_ns(&t.timer, until, kairos_timer_slack(current));
 		hrtimer_sleeper_start_expires(&t, HRTIMER_MODE_REL);
 	}
 
diff --git a/include/linux/wait.h b/include/linux/wait.h
index dce055e6add39083642ccbf324709b7493b9a8b3..81de24fcf8b9f6e60892813b99ee15df9e1db438 100644
--- a/include/linux/wait.h
+++ b/include/linux/wait.h
@@ -4,6 +4,7 @@
 /*
  * Linux wait queue related types and methods
  */
+#include <linux/kairos_class.h>
 #include <linux/list.h>
 #include <linux/stddef.h>
 #include <linux/spinlock.h>
@@ -551,7 +552,7 @@ do {										\
 				       HRTIMER_MODE_REL);			\
 	if ((timeout) != KTIME_MAX) {						\
 		hrtimer_set_expires_range_ns(&__t.timer, timeout,		\
-					current->timer_slack_ns);		\
+					kairos_timer_slack(current));		\
 		hrtimer_sleeper_start_expires(&__t, HRTIMER_MODE_REL);		\
 	}									\
 										\
diff --git a/ipc/sem.c b/ipc/sem.c
index 6cdf862b1f5ccd4480594105a3873d083f6f9b8e..88bb537102251596492eb7bd6997d4d5e310b8af 100644
--- a/ipc/sem.c
+++ b/ipc/sem.c
@@ -84,6 +84,7 @@
 #include <linux/rwsem.h>
 #include <linux/nsproxy.h>
 #include <linux/ipc_namespace.h>
+#include <linux/kairos_class.h>
 #include <linux/sched/wake_q.h>
 #include <linux/nospec.h>
 #include <linux/rhashtable.h>
@@ -2164,7 +2165,7 @@ long __do_semtimedop(int semid, struct sembuf *sops,
 		rcu_read_unlock();
 
 		timed_out = !schedule_hrtimeout_range(exp,
-				current->timer_slack_ns, HRTIMER_MODE_ABS);
+				kairos_timer_slack(current), HRTIMER_MODE_ABS);
 
 		/*
 		 * fastpath: the semop has completed, either successfully or
diff --git a/kernel/futex/requeue.c b/kernel/futex/requeue.c
index d818b4d47f1bad0e9eefe1fb12dbfac2715e6292..16e1065bf31e3c13d26a024a34be8b291b79c28c 100644
--- a/kernel/futex/requeue.c
+++ b/kernel/futex/requeue.c
@@ -1,5 +1,6 @@
 // SPDX-License-Identifier: GPL-2.0-or-later
 
+#include <linux/kairos_class.h>
 #include <linux/plist.h>
 #include <linux/sched/signal.h>
 
@@ -797,7 +798,7 @@ int futex_wait_requeue_pi(u32 __user *uaddr, unsigned int flags,
 		return -EINVAL;
 
 	to = futex_setup_timer(abs_time, &timeout, flags,
-			       current->timer_slack_ns);
+			       kairos_timer_slack(current));
 
 	/*
 	 * The waiter is allocated on our stack, manipulated by the requeue
diff --git a/kernel/futex/waitwake.c b/kernel/futex/waitwake.c
index 1c2dd03f11ec4e5d34d1a9f67ef01e05604b3bac..df79f22e22ed65685822e0436269d6f212f2930c 100644
--- a/kernel/futex/waitwake.c
+++ b/kernel/futex/waitwake.c
@@ -4,6 +4,7 @@
 #include <linux/sched/task.h>
 #include <linux/sched/signal.h>
 #include <linux/freezer.h>
+#include <linux/kairos_class.h>
 
 #include "futex.h"
 
@@ -710,7 +711,7 @@ int futex_wait(u32 __user *uaddr, unsigned int flags, u32 val, ktime_t *abs_time
 	int ret;
 
 	to = futex_setup_timer(abs_time, &timeout, flags,
-			       current->timer_slack_ns);
+			       kairos_timer_slack(current));
 
 	ret = __futex_wait(uaddr, flags, val, to, bitset);
 
diff --git a/kernel/signal.c b/kernel/signal.c
index d65d0fe24bfb8c6f859ce47f36ab975308b1b598..3342ee4cb6e450a05380ca798094df4674e30aa2 100644
--- a/kernel/signal.c
+++ b/kernel/signal.c
@@ -22,6 +22,7 @@
 #include <linux/sched/cputime.h>
 #include <linux/file.h>
 #include <linux/fs.h>
+#include <linux/kairos_class.h>
 #include <linux/mm.h>
 #include <linux/proc_fs.h>
 #include <linux/tty.h>
@@ -3777,7 +3778,7 @@ static int do_sigtimedwait(const sigset_t *which, kernel_siginfo_t *info,
 		spin_unlock_irq(&tsk->sighand->siglock);
 
 		__set_current_state(TASK_INTERRUPTIBLE|TASK_FREEZABLE);
-		ret = schedule_hrtimeout_range(to, tsk->timer_slack_ns,
+		ret = schedule_hrtimeout_range(to, kairos_timer_slack(tsk),
 					       HRTIMER_MODE_REL);
 		spin_lock_irq(&tsk->sighand->siglock);
 		__set_task_blocked(tsk, &tsk->real_blocked);
