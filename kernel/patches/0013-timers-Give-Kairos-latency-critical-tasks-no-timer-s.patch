From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Aayush Nair <aayushnair204@gmail.com>
Date: Wed, 25 Nov 2026 02:19:18 -0500
Subject: [PATCH] timers: Give Kairos latency-critical tasks no timer slack

A timed wait arms a timer that may fire anywhere from its expiry to its
expiry plus the task's timer slack, so that the kernel can serve several
timers with one interrupt. Ordinary tasks get 50 us, realtime tasks
none (__setscheduler_params()); poll, select and epoll use 0.1% of the
timeout, at most 100 ms and at least the task's slack. Kairos runs a
latency-critical service next to batch work, and the kernel keeps every
group's class (CONFIG_CGROUP_KAIROS). Measured at real speed, the slack
was most of such a task's typical wakeup delay: 58 us with it, 9 us
without.

Add CONFIG_KAIROS_TIMERS and kairos_timer_slack(): the slack for a timed
wait of a task is none if the task is latency-critical and still has the
slack it started with, and the task's own otherwise; a task that chose
its own slack (prctl(PR_SET_TIMERSLACK), /proc/PID/timerslack_ns) keeps
it. The class is read at each wait, so a relabelled group's tasks get
the new rule at their next wait. Use it in hrtimer_nanosleep() (sleeps)
and select_estimate_accuracy() (poll, select, epoll). Without the
option, the helper is the task's own slack, as before.

"kairos.notimerclass" on the command line turns it off.

Signed-off-by: Aayush Nair <aayushnair204@gmail.com>
---
 fs/select.c                  |  3 ++-
 include/linux/kairos_class.h | 13 ++++++++++++
 init/Kconfig                 | 16 +++++++++++++++
 kernel/cgroup/kairos.c       | 39 ++++++++++++++++++++++++++++++++++++
 kernel/time/hrtimer.c        |  3 ++-
 5 files changed, 72 insertions(+), 2 deletions(-)

diff --git a/fs/select.c b/fs/select.c
index e0244dbe44291653296005a48bf49505f03be100..494121701d9f9251f85b74059a2f29a64da2c077 100644
--- a/fs/select.c
+++ b/fs/select.c
@@ -30,6 +30,7 @@
 #include <linux/rcupdate.h>
 #include <linux/hrtimer.h>
 #include <linux/freezer.h>
+#include <linux/kairos_class.h>
 #include <net/busy_poll.h>
 #include <linux/vmalloc.h>
 
@@ -77,7 +78,7 @@ u64 select_estimate_accuracy(struct timespec64 *tv)
 {
 	u64 ret;
 	struct timespec64 now;
-	u64 slack = current->timer_slack_ns;
+	u64 slack = kairos_timer_slack(current);
 
 	if (slack == 0)
 		return 0;
diff --git a/include/linux/kairos_class.h b/include/linux/kairos_class.h
index ff82b8c77cddfacebb7d9c4af3f930240265d932..d661588d210ffffbbfbfedc9c25f2c46b7ca8bf0 100644
--- a/include/linux/kairos_class.h
+++ b/include/linux/kairos_class.h
@@ -76,4 +76,17 @@ static inline bool kairos_ioclass_on(void)
 }
 #endif
 
+/*
+ * Kairos's timer hook (CONFIG_KAIROS_TIMERS): the timer slack a timed wait
+ * of a task gets. With the hook, a function in kernel/cgroup/kairos.c;
+ * without it, the task's own slack. A macro then, since a header this
+ * small can't see inside struct task_struct; it is expanded only where the
+ * caller can.
+ */
+#ifdef CONFIG_KAIROS_TIMERS
+u64 kairos_timer_slack(struct task_struct *p);
+#else
+#define kairos_timer_slack(p)	((p)->timer_slack_ns)
+#endif
+
 #endif /* _LINUX_KAIROS_CLASS_H */
diff --git a/init/Kconfig b/init/Kconfig
index a0fb912df7ee3c17eb1c6163457582f5e9d76bb7..35bd3501367658f066e9e04b279b85edce203e29 100644
--- a/init/Kconfig
+++ b/init/Kconfig
@@ -1393,6 +1393,22 @@ config KAIROS_IO
 
 	  If unsure, say N.
 
+config KAIROS_TIMERS
+	bool "Timers that follow Kairos task classes"
+	depends on CGROUP_KAIROS
+	default n
+	help
+	  Lets the class of the kairos controller (CGROUP_KAIROS) steer
+	  timer slack: the timed waits of a latency-critical task (sleeps,
+	  poll, select and epoll timeouts, futex waits and the like) end on
+	  time, with no slack, as a realtime task's do, unless the task
+	  chose a slack of its own. Other tasks keep the usual slack, which
+	  lets the kernel serve several timers with one interrupt.
+
+	  "kairos.notimerclass" on the kernel command line turns it off.
+
+	  If unsure, say N.
+
 config CGROUP_DEBUG
 	bool "Debug controller"
 	default n
diff --git a/kernel/cgroup/kairos.c b/kernel/cgroup/kairos.c
index df856d1695d162c7384f8175fa632fe574c81066..e835ec1df9b5ca4c9dd400b3b4dc6fb408b61827 100644
--- a/kernel/cgroup/kairos.c
+++ b/kernel/cgroup/kairos.c
@@ -271,6 +271,45 @@ static int __init kairos_noioclass_setup(char *str)
 __setup("kairos.noioclass", kairos_noioclass_setup);
 #endif
 
+#ifdef CONFIG_KAIROS_TIMERS
+/* Kairos's timer hook: on, unless kairos.notimerclass is on the command line. */
+static bool kairos_timerclass __read_mostly = true;
+
+static int __init kairos_notimerclass_setup(char *str)
+{
+	if (*str)
+		return 0;
+	kairos_timerclass = false;
+	return 1;
+}
+__setup("kairos.notimerclass", kairos_notimerclass_setup);
+
+/**
+ * kairos_timer_slack - the timer slack for a timed wait of a task
+ * @p: the task, which is about to wait
+ *
+ * A timed wait arms a timer that may fire anywhere within its slack, so
+ * that the kernel can serve several timers with one interrupt; realtime
+ * tasks have none (__setscheduler_params()). A latency-critical task gets
+ * none either, unless it chose a slack of its own (prctl(PR_SET_TIMERSLACK)
+ * or /proc/PID/timerslack_ns): then it still has the one it started with.
+ * The class is read at each wait, so a relabelled group's tasks get the new
+ * rule at their next wait. Any context.
+ *
+ * Return: the slack, in nanoseconds.
+ */
+u64 kairos_timer_slack(struct task_struct *p)
+{
+	u64 slack = READ_ONCE(p->timer_slack_ns);
+
+	if (kairos_timerclass && slack == READ_ONCE(p->default_timer_slack_ns) &&
+	    kairos_task_class(p) == KAIROS_CLASS_LC)
+		return 0;
+	return slack;
+}
+EXPORT_SYMBOL_GPL(kairos_timer_slack);
+#endif
+
 __bpf_kfunc_start_defs();
 
 /**
diff --git a/kernel/time/hrtimer.c b/kernel/time/hrtimer.c
index 1e37142fe52f4ebaa726cd9b5e87154f22e3e699..2b0aa392694632b31cbe08bfc8c34a5e2ee7d22a 100644
--- a/kernel/time/hrtimer.c
+++ b/kernel/time/hrtimer.c
@@ -42,6 +42,7 @@
 #include <linux/timer.h>
 #include <linux/freezer.h>
 #include <linux/compat.h>
+#include <linux/kairos_class.h>
 
 #include <linux/uaccess.h>
 
@@ -2168,7 +2169,7 @@ long hrtimer_nanosleep(ktime_t rqtp, const enum hrtimer_mode mode,
 	int ret = 0;
 
 	hrtimer_setup_sleeper_on_stack(&t, clockid, mode);
-	hrtimer_set_expires_range_ns(&t.timer, rqtp, current->timer_slack_ns);
+	hrtimer_set_expires_range_ns(&t.timer, rqtp, kairos_timer_slack(current));
 	ret = do_nanosleep(&t, mode);
 	if (ret != -ERESTART_RESTARTBLOCK)
 		goto out;
