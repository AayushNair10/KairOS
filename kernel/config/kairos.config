# Kairos's kernel switches, on top of the starting point named in ./base.
#
# Each group says what it is for and what happened without it.
# scripts/kernel-build.sh stops if a line here doesn't make it into the final
# config.

# The console.
#
# The board's serial port, and its use for the kernel's messages. Without
# these the kernel boots in silence: it runs, but nothing it prints goes
# anywhere.
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y

# The initramfs.
#
# Lets the kernel unpack an archive of files into memory and start its first
# program from there. Without it the kernel looks for a disk to start from,
# finds none and panics: "VFS: Unable to mount root fs".
CONFIG_BLK_DEV_INITRD=y
