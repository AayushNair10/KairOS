# Kairos's kernel switches, on top of the starting point named in ./base.
#
# Each group says what it is for and what happened without it.
# scripts/kernel-build.sh stops if a line here doesn't make it into the final
# config.

# The console.
#
# The board's serial port, and its use for the kernel's messages. Without
# these the kernel boots in silence: it runs, but nothing it prints goes
# anywhere.
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y

# The initramfs.
#
# Lets the kernel unpack an archive of files into memory and start its first
# program from there. Without it the kernel looks for a disk to start from,
# finds none and panics: "VFS: Unable to mount root fs".
CONFIG_BLK_DEV_INITRD=y

# Running programs.
#
# The kernel starts a file only if it has a loader for the file's format.
# These are the loaders for compiled programs (ELF) and for scripts that
# name their interpreter on the first line ("#!/bin/sh"). Without them the
# kernel finds /init but can't run it: "Failed to execute /init (error -8)",
# then "No working init found".
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y

# The device file system.
#
# The kernel keeps /dev filled in by itself: one entry for every device it
# has a driver for, such as the serial port. Without it /dev holds only
# "console", and the shell can't open the serial port as its terminal:
# "can't access tty; job control turned off".
CONFIG_DEVTMPFS=y

# sched_ext: a scheduler loaded as a BPF program.
#
# This is what Kairos Scheduler plugs into. It needs three things below it:
#   - BPF: the system call that loads programs, and the compiler that turns
#     them into machine code;
#   - a description of the kernel's own data types (BTF), which a BPF
#     program is matched against when it is loaded;
#   - full debug information, which that description is made from. The debug
#     switches only exist once "kernel debugging" is on.
# Without these, /sys/kernel/sched_ext doesn't exist.
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_DEBUG_KERNEL=y
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_SCHED_CLASS_EXT=y
