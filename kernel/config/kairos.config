# Kairos's kernel switches, on top of the starting point named in ./base.
#
# Each group says what it is for and what happened without it.
# scripts/kernel-build.sh stops if a line here doesn't make it into the final
# config.

# The console.
#
# The board's serial port, and its use for the kernel's messages. Without
# these the kernel boots in silence: it runs, but nothing it prints goes
# anywhere.
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y

# The initramfs.
#
# Lets the kernel unpack an archive of files into memory and start its first
# program from there. Without it the kernel looks for a disk to start from,
# finds none and panics: "VFS: Unable to mount root fs".
CONFIG_BLK_DEV_INITRD=y

# Running programs.
#
# The kernel starts a file only if it has a loader for the file's format.
# These are the loaders for compiled programs (ELF) and for scripts that
# name their interpreter on the first line ("#!/bin/sh"). Without them the
# kernel finds /init but can't run it: "Failed to execute /init (error -8)",
# then "No working init found".
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y

# The device file system.
#
# The kernel keeps /dev filled in by itself: one entry for every device it
# has a driver for, such as the serial port. Without it /dev holds only
# "console", and the shell can't open the serial port as its terminal:
# "can't access tty; job control turned off".
CONFIG_DEVTMPFS=y

# sched_ext: a scheduler loaded as a BPF program.
#
# This is what Kairos Scheduler plugs into. It needs three things below it:
#   - BPF: the system call that loads programs, and the compiler that turns
#     them into machine code;
#   - a description of the kernel's own data types (BTF), which a BPF
#     program is matched against when it is loaded;
#   - full debug information, which that description is made from. The debug
#     switches only exist once "kernel debugging" is on.
# Without these, /sys/kernel/sched_ext doesn't exist.
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_DEBUG_KERNEL=y
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_SCHED_CLASS_EXT=y

# Control groups, and scheduling by group.
#
# A control group is a named set of processes that the kernel can give a
# limit or a share to as one. The second line lets the scheduler work with
# such groups. With it, the kernel's table of the callbacks a BPF scheduler
# may provide gets its group callbacks; that is the third line, which the
# config system switches on by itself.
#
# Kairos Scheduler provides none of those callbacks, but its loader is built
# with the kernel's own tools for sched_ext, and their code names two of
# them. Against a kernel without them the loader doesn't compile: "struct
# ...sched_ext_ops has no member named 'cgroup_set_bandwidth'".
CONFIG_CGROUPS=y
CONFIG_CGROUP_SCHED=y
CONFIG_EXT_GROUP_SCHED=y

# A task's class, in the kernel: Kairos's own control-group controller
# (our patches; kernel/cgroup/kairos.c). Every group gets the files
# kairos.class and kairos.class.effective, and Kairos Scheduler asks the
# kernel for a task's class from them.
#
# Without it there are no such files: init falls back to telling the
# scheduler which group is batch, and the boot test's kclass and relabel
# checks fail ("lc missing").
CONFIG_CGROUP_KAIROS=y

# Kairos Scheduler attached before init (our patches; init/kairos_scheduler.c).
#
# Once its setup is done, before it starts init, the kernel runs
# /bin/kairos-attach from the initramfs (image/kairos-attach) and waits for
# it. That program loads the scheduler and pins it in the BPF file system;
# init then adopts it. So init and every program after it run under Kairos
# Scheduler. "kairos.noscheduler" skips it.
#
# Without it, init loads the scheduler itself: in the boot test, sched_ext's
# "enabled" line came at console line 141, after the kernel had started
# /init at line 137; init and the loader ran on the kernel's default
# scheduler meanwhile (the early check fails).
CONFIG_KAIROS_BOOT_SCHEDULER=y

# A disk.
#
# QEMU shows Kairos a disk image as a virtio disk: a paravirtual device,
# which shares a ring of requests with QEMU instead of imitating a real
# disk controller. The second line is the transport on this board: virtio
# devices in memory-mapped slots that the device tree lists. The fourth is
# the disk driver, which makes /dev/vda. The first and third are the menus
# they sit in (virtio drivers, block device drivers): on by default, but
# our starting point turns every switch off, and without the virtio menu
# the config system dropped the transport and the driver.
#
# Without them, booted with the disk attached, there was no /dev/vda, and
# the kernel's log had nothing about a disk.
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_MMIO=y
CONFIG_BLK_DEV=y
CONFIG_VIRTIO_BLK=y

# The file system on the disk: ext4, with its journal (jbd2 comes with it).
# ext4 maps names to files and files to blocks; before it changes its own
# structures in place it writes the change to the journal, and after a
# crash it replays the journal, as a database replays its write-ahead log.
#
# Without it, with the disk there: "mount: mounting /dev/vda on /mnt
# failed: No such device" (the kernel knew no file system called ext4).
CONFIG_EXT4_FS=y

# Memory by group, and how long tasks wait for it.
#
# The first line is the memory controller. It charges every page of memory
# to the control group of the task that first used it, and gives every
# group its memory.* files: what it uses (memory.stat), and how much of it
# the kernel should protect (memory.min, memory.low) or allow (memory.high,
# memory.max) when memory runs short. Kairos's memory hooks protect LC
# groups by their class through it.
#
# The second line is pressure stall information: the share of time tasks
# spend waiting for memory (or a CPU, or I/O), system-wide in
# /proc/pressure and per group in memory.pressure. It is how a run shows
# whether LC waited for memory.
#
# Without the first, init couldn't switch it on and lc and batch had only
# the CPU controller (the boot test's memory check: "lc: cpu; batch: cpu").
# Without the second there are no pressure files.
CONFIG_MEMCG=y
CONFIG_PSI=y

# The CPU layout, for the scheduler.
#
# The kernel reads which CPUs are hardware threads of one core, which form
# a cluster, and which share a cache, from the firmware (on arm64, the
# device tree's cpu-map), and builds from it a tree of scheduling domains
# per CPU. Linux's own scheduler (EEVDF) uses the tree: on wakeup it looks
# for a whole idle core before an idle thread, and it balances work within
# a cluster or cache before across. sched_ext's "whole idle cores" mask is
# real only with the first line; without it the mask is just the idle
# CPUs. The fourth line adds memory nodes: the kernel allocates a CPU's
# memory near it, and /sys/devices/system/node shows which CPUs are where.
#
# Without them, booted as 2 clusters x 2 cores x 2 threads (sched_verbose
# on the command line, with ignore_loglevel), the kernel built one level,
# "domain-0: span=0-7 level=PKG", every CPU a separate peer; and with two
# memory nodes it knew one.
CONFIG_SCHED_SMT=y
CONFIG_SCHED_CLUSTER=y
CONFIG_SCHED_MC=y
CONFIG_NUMA=y

# Files in memory.
#
# The first line is a file system that keeps its files in memory and on no
# disk (tmpfs). The second is a system call that comes with it, which makes
# a file in memory that has no name anywhere. The BPF library uses such
# files as stand-ins while it prepares a program for loading.
#
# Without the system call the loader stops at its first step:
# "failed to initialize skeleton BPF object 'scx_kairos': -38" and
# "Function not implemented".
CONFIG_TMPFS=y
CONFIG_MEMFD_CREATE=y

# Networking.
#
# Only its core: sockets, with no protocol and no driver for a network card
# yet. It is here for one thing it brings, the oldest kind of BPF program: a
# filter on a socket.
#
# The BPF library finds out what a kernel can do by trying: it loads small
# test programs, most of them as socket filters. A kernel that doesn't know
# socket filters fails those tests for the wrong reason.
#   - The first test is whether a BPF program can be loaded at all. Without
#     networking and without BPF tracing (below), which that one test falls
#     back on: "Couldn't load trivial BPF program".
#   - Another is whether BPF programs can have global variables. Failing
#     it, the library takes the kernel for one too old to have them and
#     quietly doesn't create the maps that hold the policy's. The policy
#     still refers to them, so the kernel's checker refused it: "fd 9 is
#     not pointing to valid bpf_map".
CONFIG_NET=y

# BPF tracing.
#
# The part of the kernel that lets a BPF program be attached to an event.
# The last line is the switch we are after. It needs the first (perf
# events: the kernel's way of counting and reporting events), the second
# (the menu that all tracing sits under) and one tracer to stand on. The
# third is the smallest of those: events at a point in a program's code.
#
# Kairos Scheduler attaches to no event. It calls the helper that tells a
# BPF program which task is running on its CPU, and that helper's code is
# in the tracing part of the kernel. Without it the kernel's checker
# refused the policy: "program of this type cannot use helper
# bpf_get_current_task_btf#158".
CONFIG_PERF_EVENTS=y
CONFIG_FTRACE=y
CONFIG_UPROBE_EVENTS=y
CONFIG_BPF_EVENTS=y

# Precise timers.
#
# Without this the kernel looks at its timers only on the tick, the
# interrupt that each CPU's clock raises at a fixed rate. A timer set for
# 1 ms from now then fires on the next tick or the one after. With it, the
# kernel sets the clock to interrupt at the moment the next timer is due.
#
# Kairos Scheduler's policy runs on a timer of 1 ms, and makes a waking
# latency-critical task wait up to 1 ms before it preempts. Without precise
# timers /proc/timer_list gave the resolution as 4000000 ns, and with the
# scheduler loaded no CPU took more than 250 timer interrupts a second: the
# policy's timer fired a quarter as often as it asked to. With them the
# resolution is 1 ns, and the CPU that runs that timer takes about 870.
CONFIG_HIGH_RES_TIMERS=y

# The tick: 1000 a second.
#
# The tick is the interrupt that each CPU's clock raises at a fixed rate.
# On it the kernel does its regular bookkeeping for whatever is running on
# that CPU, and that is where it notices that the running task's slice has
# run out. So a busy task isn't stopped when its slice ends but on the
# first tick after that: it runs up to one tick too long.
#
# At the default of 250 a second that is up to 4 ms, more than Kairos
# Scheduler's whole slice for a latency-critical task (3 ms). At 1000 it
# is up to 1 ms, and 1000 is what the kernel the scheduler was evaluated on
# has. Measured with two busy tasks sharing one CPU, how long each ran at a
# time:
#
#   slice 3 ms,   250 ticks a second    4.0 ms
#   slice 2.5 ms, 1000                  3.1 ms
#   slice 3 ms,   1000                  3.7 ms
#   slice 3.5 ms, 1000                  4.0 ms
#
# A slice of exactly 3 ms has a few microseconds left on the third tick, so
# on a steady clock it runs to the fourth: the evaluation kernel gives
# 4.0 ms. QEMU's ticks are less even, which is where 3.7 comes from.
#
# The cost: every CPU takes 1000 timer interrupts a second, idle or not.
CONFIG_HZ_1000=y
CONFIG_HZ=1000

# No tick on an idle CPU.
#
# A CPU with nothing to run has no slice to check and no bookkeeping to
# do, so its tick only wakes it up for nothing. With this the kernel stops
# the tick on a CPU when it goes idle and starts it again when the CPU has
# work.
#
# Without it, an idle system took about 785 timer interrupts a second on
# each of its 4 CPUs (QEMU doesn't deliver all 1000). With it, fewer than 6.
# With Kairos Scheduler loaded, one CPU still takes about 700 a second: the
# one that runs the policy's 1 ms timer.
CONFIG_NO_HZ_IDLE=y

# The kernel's name for itself: "7.0.0-kairos" in its first message and in
# uname. It shows at a glance which kernel a machine is running.
CONFIG_LOCALVERSION="-kairos"
