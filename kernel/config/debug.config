# Switches for a kernel that checks our changes' locking, on top of
# kairos.config. kernel-build.sh --debug adds them and builds into
# ~/kairos-build-debug; boot it with run-qemu.sh or boot-test.sh
# --kernel ~/kairos-build-debug/arch/arm64/boot/Image. It is slower, and
# not what Kairos ships.
#
# The kernel's debugging options are hidden until the first line is on.
CONFIG_DEBUG_KERNEL=y

# Lockdep. It records, for every lock, which locks were already held when it
# was taken, and reports an order that could deadlock the first time both
# halves of it happen, even if they never collide in this run. It also checks
# that pointers shared through RCU are read inside an RCU read section or
# under the lock that guards them (PROVE_RCU comes with it).
CONFIG_PROVE_LOCKING=y

# Reports code that may sleep, such as taking a mutex, where sleeping isn't
# allowed: inside an RCU read section, or with a spinlock held.
CONFIG_DEBUG_ATOMIC_SLEEP=y
