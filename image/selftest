#!/bin/sh
# What a boot test runs in place of the shell.
#
# With the word kairos.test on the kernel's command line, the first program
# starts this script instead of a shell. It prints facts about the running
# system, one per line, each starting with "kairos.test:".
# scripts/boot-test.sh reads them from the console's output and decides
# whether the boot passed.

echo "kairos.test: kernel $(uname -r)"
# The program running as process 1. Ours is /init.
echo "kairos.test: init $(readlink /proc/1/exe)"
echo "kairos.test: cpus $(nproc)"

# The root file system: its type, where it comes from and whether it can
# be written: "ext4 /dev/vda rw" once init has switched to the disk,
# "rootfs rootfs rw" while Kairos runs from the initramfs in memory. The
# last line for / is the one on top.
echo "kairos.test: root $(awk '$2 == "/" { t = $3; d = $1; o = substr($4, 1, 2) }
	END { print t, d, o }' /proc/mounts)"
# Whether the initramfs is still mounted. After the switch to the disk,
# init unmounts it and its memory is freed.
if grep -q '^rootfs ' /proc/mounts; then
	echo "kairos.test: initramfs mounted"
else
	echo "kairos.test: initramfs gone"
fi
# The boot log on the disk: init adds a line at every boot.
bootlog=/var/log/kairos/boots
if [ -f $bootlog ]; then
	echo "kairos.test: bootlog $(wc -l <$bootlog)"
else
	echo "kairos.test: bootlog none"
fi

# The disk's I/O scheduler (the one in brackets is in use), and
# mq-deadline's aging limit: how many ms a request of a lower priority
# class may wait before it is served anyway.
if [ -e /sys/block/vda/queue/scheduler ]; then
	echo "kairos.test: iosched $(cat /sys/block/vda/queue/scheduler) aging $(cat /sys/block/vda/queue/iosched/prio_aging_expire 2>/dev/null || echo none)"
else
	echo "kairos.test: iosched no disk"
fi

# Disk mode (scripts/disk-test.sh): with kairos.disk, report the marker the
# previous boot left on the disk, leave a new one (the boot's number in the
# log), write it out, and end; init powers off cleanly. With
# kairos.powercut too, also write a second file without writing it out,
# then cut the power: poweroff -f -n tells the kernel to power off at once,
# with nothing written out and the disk never unmounted, as a power cut
# would leave it.
if grep -qw kairos.disk /proc/cmdline; then
	marker=/var/lib/kairos-test/marker
	echo "kairos.test: marker $(cat $marker 2>/dev/null || echo none)"
	# After a power cut: what became of the file that was never written
	# out. Anything may happen to it (missing, empty, or there); only
	# reported.
	unsynced=${marker%/*}/unsynced
	if [ -e $unsynced ]; then
		echo "kairos.test: unsynced $(wc -c <$unsynced) bytes"
		rm -f $unsynced
	else
		echo "kairos.test: unsynced missing"
	fi
	mkdir -p ${marker%/*}
	wc -l <$bootlog >$marker
	sync
	if grep -qw kairos.powercut /proc/cmdline; then
		echo "not written out" >${marker%/*}/unsynced
		echo "kairos.test: power cut"
		poweroff -f -n
	fi
	exit 0
fi

# Kernel tracing, for counts that emulation's speed can't distort. The
# events turned on are recorded per CPU into a ring buffer (the trace
# file), read after they are turned off again. A full buffer overwrites
# its oldest events: trace_lost says how many were lost, and a count is
# only reported whole if none were.
T=/sys/kernel/tracing
trace_on() {	# trace_on EVENT...: record these, from now
	grep -q " $T tracefs " /proc/mounts || mount -t tracefs nodev $T
	echo 0 >$T/tracing_on
	echo 0 >$T/events/enable
	echo 4096 >$T/buffer_size_kb
	echo >$T/trace
	for e in "$@"; do
		echo 1 >"$T/events/$e/enable"
	done
	echo 1 >$T/tracing_on
}
trace_off() {
	echo 0 >$T/tracing_on
	echo 0 >$T/events/enable
}
trace_lost() {
	cat $T/per_cpu/cpu*/stats | awk '/^overrun:/ { n += $2 } END { print n + 0 }'
}
# ahead COMM: from a trace of wakeups and task switches, for each wakeup of
# a program called COMM: how many other tasks had its CPU between the
# wakeup and the moment it ran there (the CPU it ran on, which may not be
# the one it woke on), counting the task that was running when it woke.
# 0: the CPU was idle; 1: one task ran first (often the one it preempted).
# Prints the wakeups counted, the mean, the share with none and with at
# most one, and the most.
ahead() {
	awk -v comm="$1" -v ncpu="$(nproc)" '
	/ sched_switch: / {
		match($0, /\[[0-9]+\]/)
		c = substr($0, RSTART + 1, RLENGTH - 2) + 0
		match($0, /next_pid=[0-9]+/)
		q = substr($0, RSTART + 9, RLENGTH - 9) + 0
		if (!(c in seen)) {
			# The first switch seen on this CPU: what it switched
			# from had the CPU since the trace began.
			match($0, /prev_pid=[0-9]+/)
			pp = substr($0, RSTART + 9, RLENGTH - 9) + 0
			for (w in woken)
				if (busy[w, c] == -1)
					busy[w, c] = pp != 0
			seen[c] = 1
		}
		if (q in woken) {
			k = runs[c] - snap[q, c] + busy[q, c]
			n++
			total += k
			if (k == 0)
				zero++
			if (k <= 1)
				one++
			if (k > most)
				most = k
			delete woken[q]
		} else if (q != 0) {
			runs[c]++
		}
		cur[c] = q
		next
	}
	/ sched_wakeup: / {
		if (index($0, "comm=" comm " ") == 0)
			next
		match($0, /pid=[0-9]+/)
		p = substr($0, RSTART + 4, RLENGTH - 4) + 0
		# Woken before it was switched out (on its way to sleep):
		# not counted.
		for (c in seen)
			if (cur[c] == p)
				next
		woken[p] = 1
		for (c = 0; c < ncpu; c++) {
			snap[p, c] = runs[c]
			# A CPU with no switch seen yet: decided at its first.
			busy[p, c] = (c in seen) ? cur[c] != 0 : -1
		}
	}
	END {
		if (n)
			printf "%d %.2f %d%% %d%% %d", n, total / n, 100 * zero / n, 100 * one / n, most
		else
			printf "0 0 0%% 0%% 0"
	}' $T/trace
}
# order: from a trace of disk requests put into the I/O scheduler and sent
# to the disk, for each request of the LC reader (lcprobe): how many other
# requests were sent to the disk while it waited, and how many of those
# had come in after it (they overtook it). Prints the LC requests counted,
# the mean sent while it waited, the most, the mean that overtook it, and
# how many of the other requests came in as best-effort and how many as
# idle class.
order() {
	awk '
	/ block_rq_(insert|issue): / {
		ins = $0 ~ / block_rq_insert: /
		line = $0
		sub(/.* block_rq_(insert|issue): /, "", line)
		# dev rwbs bytes (cmd) sector + sectors class,hint,level [comm]
		split(line, f, " ")
		key = f[1] " " f[5]
		if (ins) {
			seq[key] = ++s
			if (line ~ /\[lcprobe\]$/) {
				waited[key] = 0
				over[key] = 0
			} else {
				split(f[8], cl, ",")
				classes[cl[1]]++
			}
			next
		}
		if (key in waited) {
			n++
			total += waited[key]
			overtook += over[key]
			if (waited[key] > most)
				most = waited[key]
			delete waited[key]
			next
		}
		for (k in waited) {
			waited[k]++
			if ((key in seq) && seq[key] > seq[k])
				over[k]++
		}
	}
	END {
		printf "%d %.2f %d %.2f be=%d idle=%d", n, n ? total / n : 0, most, n ? overtook / n : 0, classes["be"], classes["idle"]
	}' $T/trace
}

# CPU mode (scripts/cpu-test.sh): with kairos.cpu, how late an LC
# program's wakeups are while crunch keeps every CPU busy, then the
# self-test ends; init powers off. The program (lcprobe) runs in its own
# group below lc and wakes every 2 ms for 4 s, three times: without
# crunch, with crunch as batch, and with crunch relabelled LC (one write to
# its group). The demo probe service is stopped first. For each: the
# median and 99th percentile of the delays, in us, then from a trace of
# wakeups and task switches, how many other tasks had its CPU first
# (ahead: wakeups counted, mean, share with none, share with at most one,
# most), and the events the trace lost.
# With kairos.batchidle as well, batch's group is made an idle group
# first (cpu.idle: its tasks run only when nothing else wants the CPU;
# Linux's own way to run work in the background), for comparing with
# Linux's scheduler at its best for this case.
if grep -qw kairos.cpu /proc/cmdline; then
	g=/sys/fs/cgroup/lc/cputest
	mkdir -p $g
	cpurun() {
		trace_on sched/sched_wakeup sched/sched_switch
		set -- $(sh -c "echo \$\$ >$g/cgroup.procs; exec lcprobe -p 2000 -r 4 -n 1" |
			sed -n 's/.*median \([0-9]*\) us, 99% \([0-9]*\) us.*/\1 \2/p')
		trace_off
		echo "$1 $2 ahead $(ahead lcprobe) lost $(trace_lost)"
	}
	crunchg=/sys/fs/cgroup/batch/crunch
	grep -qw kairos.batchidle /proc/cmdline && echo 1 >/sys/fs/cgroup/batch/cpu.idle
	service stop probe >/dev/null 2>&1
	service stop crunch >/dev/null 2>&1
	sleep 1
	echo "kairos.test: cpu idle $(cpurun)"
	service start crunch >/dev/null 2>&1
	sleep 1
	echo "kairos.test: cpu batch $(cpurun)"
	echo lc >"$crunchg/kairos.class"
	echo "kairos.test: cpu lc $(cpurun)"
	echo inherit >"$crunchg/kairos.class"
	service stop crunch >/dev/null 2>&1
	exit 0
fi

# I/O mode (scripts/io-test.sh): with kairos.io, LC and batch compete for
# the disk, then the self-test ends; init powers off. The test slows the
# disk (QEMU serves a few hundred requests a second) and lets one request
# at a time be at the device (virtio_blk.queue_depth=1), so the rest wait
# in the kernel, where the I/O scheduler orders them. The scheduler gets
# room for 64 waiting requests (nr_requests), as a disk with a 32-deep
# queue gets: by default a 1-deep one gets 2, and a request that can't get
# one of those waits before the scheduler sees it, in order of arrival.
#
# lc-alone, lc-loaded: how long the LC program's reads took (median and
# 99th percentile, in us): from its own group below lc, a 4 KiB read past
# the page cache every 50 ms for 5 s; first alone, then while batch reads
# back to back (8 readers) and writes 128 MB.
# lc-fsync: how long its 4 KiB writes took to reach the disk (fsync),
# every 200 ms for 5 s, while batch's writes are being written out.
# order: while LC read with batch at work, from the kernel's trace of disk
# requests: for each LC request, how many other requests the I/O scheduler
# sent to the disk while it waited, and how many of those came in after it
# (see order above), the priority classes the others came in with, and
# the events the trace lost.
# batch-writes: the bytes batch wrote, as the I/O controller charged them
# (batch's io.stat): the kernel's threads write them out later, and cgroup
# writeback charges them to the group that made them.
# batch-starved: LC keeps the disk busy (4 readers, back to back) for 9 s
# while one batch reader reads too; how many reads batch got done in 8 s,
# and the longest one, in us. A batch request is served when no LC request
# waits, or once it has waited mq-deadline's aging limit (init: 2 s).
if grep -qw kairos.io /proc/cmdline; then
	d=/var/lib/kairos-test
	g=/sys/fs/cgroup/lc/iotest
	mkdir -p $d $g
	echo 64 >/sys/block/vda/queue/nr_requests
	dd if=/dev/zero of=$d/lcdata bs=1M count=16 conv=fsync 2>/dev/null
	dd if=/dev/zero of=$d/batchdata bs=1M count=64 conv=fsync 2>/dev/null
	lcprobe() {
		sh -c "echo \$\$ >$g/cgroup.procs; exec lcprobe $*" |
			sed -n 's/.*median \([0-9]*\) us, 99% \([0-9]*\) us.*/\1 \2/p'
	}
	echo "kairos.test: io lc-alone $(lcprobe -d $d/lcdata -p 50000 -r 5 -n 1)"
	for i in 1 2 3 4 5 6 7 8; do
		batch probe -d $d/batchdata -p 1000 -r 18 -n 1 >/dev/null &
	done
	batch dd if=/dev/zero of=$d/batchwrite bs=1M count=128 2>/dev/null &
	sleep 2
	trace_on block/block_rq_insert block/block_rq_issue
	echo "kairos.test: io lc-loaded $(lcprobe -d $d/lcdata -p 50000 -r 5 -n 1)"
	trace_off
	echo "kairos.test: io order $(order) lost $(trace_lost)"
	echo "kairos.test: io lc-fsync $(lcprobe -f $d/lcsync -p 200000 -r 5 -n 1)"
	wait
	sync
	echo "kairos.test: io batch-writes $(sed -n 's/.* wbytes=\([0-9]*\).*/\1/p' /sys/fs/cgroup/batch/io.stat 2>/dev/null | head -n 1)"
	for i in 1 2 3 4; do
		sh -c "echo \$\$ >$g/cgroup.procs; exec probe -d $d/lcdata -p 1000 -r 9 -n 1" >/dev/null &
	done
	echo "kairos.test: io batch-starved $(batch probe -d $d/batchdata -p 1000 -r 8 -n 1 |
		sed -n 's/^probe: \([0-9]*\) reads.*most \([0-9]*\) us.*/\1 \2/p')"
	wait
	exit 0
fi

# Layout mode (scripts/layout-test.sh): with kairos.layout on the kernel's
# command line, report how the machine's CPUs look to the kernel and where
# the LC pool is, then end; init powers off.
#
# speeds: each CPU's speed as the kernel rates it (the fastest is 1024),
# CPU 0 first. nodes: how many memory nodes it knows.
#
# probe ran on: where the demo service probe ran, as CPU:samples. It is
# LC, and nearly the only LC work while this runs, so the LC pool is as
# small as it gets (2 CPUs: its demand and the spare) and probe runs
# there. Short LC work (a command starting, before it joins its batch
# group) can grow the pool for a moment, so a few samples may land on the
# next CPU. The sampling runs as batch work, so it doesn't count as LC
# demand: every 20 ms for 2 s, field 39 of probe's /proc/PID/stat, the CPU
# it last ran on (${37} once the name and the two fields before it are
# cut off).
if grep -qw kairos.layout /proc/cmdline; then
	speeds= cpu=0
	while [ $cpu -lt "$(nproc)" ]; do
		speeds="$speeds$(cat /sys/devices/system/cpu/cpu$cpu/cpu_capacity 2>/dev/null) "
		cpu=$((cpu + 1))
	done
	echo "kairos.test: speeds $speeds"
	echo "kairos.test: nodes $(ls -d /sys/devices/system/node/node[0-9]* 2>/dev/null | wc -l)"
	tenths=0
	while [ -z "$(pidof probe)" ] && [ $tenths -lt 100 ]; do
		sleep 0.1
		tenths=$((tenths + 1))
	done
	sleep 2
	ran=$(batch sh -c 'pid=$(pidof probe); i=0
		while [ $i -lt 100 ]; do
			read -r l </proc/$pid/stat; set -- ${l##*) }; echo ${37}
			sleep 0.02; i=$((i + 1))
		done | sort -n | uniq -c | while read -r n cpu; do printf "%s:%s " $cpu $n; done')
	echo "kairos.test: probe ran on $ran"
	exit 0
fi

# Memory mode (scripts/memory-test.sh): with kairos.memory, LC and batch
# compete for memory for 30 s, then the self-test ends; init powers off.
#
# LC: a program in its own group below lc writes a 16 MB file, then reads
# it all again every 2 s, idle in between, as a service is between
# requests: its working set. Each time it also takes 8 MB of fresh memory
# (dd's buffer) and gives it back, as a request might. Batch: reads a 512 MB file over and over, more
# than the machine has. That file is all holes (made with truncate):
# reading it fills memory with cached pages but reads nothing from the
# disk. So whatever is read from the disk meanwhile is LC reading back what
# was taken from it (and a little of everything else).
#
# lc-reads: KiB read from the disk while batch ran, and how many times LC
# read its file meanwhile. A file that stays in memory is read 0 times.
if grep -qw kairos.memory /proc/cmdline; then
	d=/var/lib/kairos-test
	g=/sys/fs/cgroup/lc/memtest
	mkdir -p $d $g
	truncate -s 512M $d/big
	sh -c "echo \$\$ >$g/cgroup.procs
		dd if=/dev/zero of=$d/lcdata bs=1M count=16 conv=fsync 2>/dev/null
		while [ ! -e $d/stop ]; do
			cat $d/lcdata >/dev/null
			dd if=/dev/zero of=/dev/null bs=8M count=1 2>/dev/null
			echo x >>$d/passes
			sleep 2
		done" &
	sleep 8
	read -r _ _ before _ </sys/block/vda/stat
	stalls_before=$(awk '/^allocstall_/ { n += $2 } END { print n }' /proc/vmstat)
	: >$d/passes
	batch sh -c "while [ ! -e $d/stop ]; do cat $d/big >/dev/null; done" &
	sleep 30
	read -r _ _ after _ </sys/block/vda/stat
	stalls_after=$(awk '/^allocstall_/ { n += $2 } END { print n }' /proc/vmstat)
	passes=$(wc -l <$d/passes)
	touch $d/stop
	echo "kairos.test: memory lc-reads $(((after - before) / 2)) KiB in $passes passes"
	# With the memory controller, from the LC program's own group: pages
	# taken from it and read back (refaults), the time its tasks were
	# stalled waiting for memory (pressure: total, in us), and how often
	# its protection was breached because nothing else could be taken
	# (memory.events low).
	stat() {
		sed -n "s/^$1 //p" "$g/memory.stat" 2>/dev/null
	}
	echo "kairos.test: memory lc-refaults $(stat workingset_refault_file)"
	echo "kairos.test: memory lc-stall $(sed -n 's/^some .*total=//p' "$g/memory.pressure" 2>/dev/null)"
	echo "kairos.test: memory lc-breaches $(sed -n 's/^low //p' "$g/memory.events" 2>/dev/null)"
	# The same for all of batch (its group's pressure counts every group
	# below it), and how many times any allocation stopped to reclaim
	# (/proc/vmstat's allocstall counters, summed).
	echo "kairos.test: memory batch-stall $(sed -n 's/^some .*total=//p' /sys/fs/cgroup/batch/memory.pressure 2>/dev/null)"
	echo "kairos.test: memory allocstalls $((stalls_after - stalls_before))"
	wait
	exit 0
fi
echo "kairos.test: devices $(ls /dev | wc -l) entries in /dev"
# Control groups: the type of file system mounted at /sys/fs/cgroup
# ("cgroup2" for control groups), and Kairos's two class groups. For each
# group, the controllers that apply to it; "cpu" means the scheduler sees a
# task in that group as being in it.
echo "kairos.test: cgroups $(awk '$2 == "/sys/fs/cgroup" { print $3 }' /proc/mounts)"
for class in lc batch; do
	if [ -d "/sys/fs/cgroup/$class" ]; then
		echo "kairos.test: cgroup $class $(cat "/sys/fs/cgroup/$class/cgroup.controllers")"
	else
		echo "kairos.test: cgroup $class missing"
	fi
done
# The state of the kernel's BPF scheduler: "enabled" while one runs,
# "disabled" when none does. The file is missing in a kernel that can't take
# one.
echo "kairos.test: sched_ext $(cat /sys/kernel/sched_ext/state 2>/dev/null || echo missing)"
# The name of the BPF scheduler that runs. The folder "root" exists only
# while one does. These lines are the first thing the self-test does, so
# they show what init left running before it started its first program.
echo "kairos.test: scheduler $(cat /sys/kernel/sched_ext/root/ops 2>/dev/null || echo none)"
# The scheduler's loader: who started it (process 1 is init) and whether it
# has a terminal. It shouldn't: Ctrl-C typed at the shell must not reach it.
loader=$(pidof scx_kairos)
if [ -n "$loader" ]; then
	set -- $(cat "/proc/$loader/stat" | sed 's/^.*) //')
	# Fields after the name: state, parent, group, session, terminal.
	echo "kairos.test: loader parent $2 terminal $5"
	# Its class rule: the --class and --batch-cgroup options it was given.
	# Without --class, --main-config's rule applies: the policy.
	args=$(tr '\0' '\n' <"/proc/$loader/cmdline")
	class=$(echo "$args" | sed -n 's/^--class=//p' | tail -n 1)
	group=$(echo "$args" | sed -n 's/^--batch-cgroup=//p' | tail -n 1)
	echo "kairos.test: loader class ${class:-policy} ${group:-none}"
	# Whether it loaded the scheduler itself, or adopted one that was
	# attached before init started (--adopt: it watches the scheduler the
	# kernel's attach program pinned).
	if echo "$args" | grep -q '^--adopt'; then
		echo "kairos.test: loader mode adopt"
	else
		echo "kairos.test: loader mode load"
	fi
else
	echo "kairos.test: loader none"
fi

# Leftovers: finished processes that nobody collected. The brackets start a
# process that puts "true" in the background and finishes at once, so "true"
# loses its parent and init adopts it. When it finishes, init has to collect
# it; until then it stays in the process table in state Z.
(true &)
sleep 1
echo "kairos.test: leftovers $(cat /proc/[0-9]*/status 2>/dev/null | grep -c '^State:.Z')"

# The terminal. /dev/tty stands for "the terminal of whoever opens it", and
# a process that has none can't open it. Without a terminal, Ctrl-C has no
# way to reach the programs a shell runs.
if (: </dev/tty) 2>/dev/null; then
	echo "kairos.test: terminal $(tty)"
else
	echo "kairos.test: terminal none"
fi

# Services. The service manager is init's child. It starts each service in a
# control group of its own, below the group for its class. The two demo
# services: probe (LC, one process, started at boot) and crunch (batch: a
# shell with one busy loop per CPU, its children; started only on request).
# The manager starts after the scheduler, so allow it up to 10 s to have
# both running, with all of crunch's loops.
procs() {
	cat "/sys/fs/cgroup/$1/cgroup.procs" 2>/dev/null | wc -l
}
service start crunch >/dev/null 2>&1
tenths=0
while [ $tenths -lt 100 ] &&
	{ [ "$(procs lc/probe)" = 0 ] || [ "$(procs batch/crunch)" -le "$(nproc)" ]; }; do
	sleep 0.1
	tenths=$((tenths + 1))
done
manager=$(pidof service)
if [ -n "$manager" ]; then
	set -- $(sed 's/^.*) //' "/proc/$manager/stat")
	echo "kairos.test: manager parent $2"
else
	echo "kairos.test: manager none"
fi
echo "kairos.test: service probe $(procs lc/probe) in lc"
echo "kairos.test: service crunch $(procs batch/crunch) in batch"
# What "service status" says about probe: its class and state.
echo "kairos.test: status probe $(service status 2>/dev/null | awk '$1 == "probe" { print $2, $3 }')"

# The kernel's class for a group: what was written to its kairos.class
# (lc, batch, or inherit: its parent's class), and the class in effect,
# from kairos.class.effective. "missing" in a kernel without the kairos
# controller.
kclass() {
	if [ -f "/sys/fs/cgroup/$1/kairos.class" ]; then
		echo "$(cat "/sys/fs/cgroup/$1/kairos.class") $(cat "/sys/fs/cgroup/$1/kairos.class.effective")"
	else
		echo missing
	fi
}
for group in lc batch batch/crunch; do
	echo "kairos.test: kclass $group $(kclass $group)"
done

# Respawn. Kill every process of crunch at once, with the group's own kill
# file, and wait up to 10 s for the manager to start it again: its group has
# a process again, and not one of the old ones.
old=" $(cat /sys/fs/cgroup/batch/crunch/cgroup.procs 2>/dev/null | tr '\n' ' ') "
back=
if [ "$old" != "  " ]; then
	echo 1 >/sys/fs/cgroup/batch/crunch/cgroup.kill
	tenths=0
	while [ $tenths -lt 100 ]; do
		sleep 0.1
		tenths=$((tenths + 1))
		new=$(head -n 1 /sys/fs/cgroup/batch/crunch/cgroup.procs)
		[ -n "$new" ] || continue
		case $old in
		*" $new "*) ;;
		*) back="$((tenths / 10)).$((tenths % 10)) s"; break ;;
		esac
	done
fi
echo "kairos.test: respawn ${back:-none}"

# Stop. A service whose first process leaves a process behind and exits at
# once, and that process ignores the request to finish (SIGTERM). The
# service still runs: its group isn't empty. "service stop" asks every
# process in the group to finish, and kills what is left after 5 s. Report
# the processes in the group before and after, the state, and the time
# the stop took.
cat >/etc/kairos/services/detach <<'END'
class batch
start manual
run trap '' TERM; sleep 1000 & exit 0
END
service start detach >/dev/null 2>&1
sleep 0.5
before=$(procs batch/detach)
t0=$(cut -d' ' -f1 /proc/uptime)
service stop detach >/dev/null 2>&1
took=$(awk -v t0="$t0" '{ printf "%.1f", $1 - t0 }' /proc/uptime)
state=$(cut -d' ' -f1 /run/service/detach/state 2>/dev/null)
echo "kairos.test: stop $before before, $(procs batch/detach) after, ${state:-unknown}, $took s"

# A one-off batch command: "batch COMMAND" runs it in a fresh group below
# batch and removes the group when it ends.
echo "kairos.test: batch $(batch cat /proc/self/cgroup 2>&1 | head -n 1)"
echo "kairos.test: batch groups left $(ls /sys/fs/cgroup/batch | grep -c '^cmd-')"

# Relabel. Write lc to crunch's group, which sits below batch, and make a
# group below crunch: it starts with crunch's class. Then write inherit:
# crunch takes batch's class again, and the group below it follows. A word
# that isn't a class must be refused.
crunchg=/sys/fs/cgroup/batch/crunch
effective() {
	cat "$1/kairos.class.effective" 2>/dev/null || echo missing
}
echo lc >"$crunchg/kairos.class" 2>/dev/null
mkdir "$crunchg/below"
set -- "$(effective "$crunchg")" "$(effective "$crunchg/below")"
echo inherit >"$crunchg/kairos.class" 2>/dev/null
set -- "$@" "$(effective "$crunchg")" "$(effective "$crunchg/below")"
if echo nonsense >"$crunchg/kairos.class" 2>/dev/null; then
	set -- "$@" accepted
else
	set -- "$@" refused
fi
rmdir "$crunchg/below"
echo "kairos.test: relabel lc: crunch $1, below $2; inherit: crunch $3, below $4; nonsense $5"

# Class. How late a small LC program's wakeups are while crunch keeps every
# CPU busy: once with crunch as batch, once with crunch as LC, and once
# without crunch, for reference. Each is the median and the 99th
# percentile, in microseconds, of 4 s of wakeups every 2 ms. Crunch becomes
# LC while it runs, with one write to its group's kairos.class.
latency() {
	probe -p 2000 -r 4 -n 1 | sed -n 's/.*median \([0-9]*\) us, 99% \([0-9]*\) us.*/\1 \2/p'
}
service stop crunch >/dev/null 2>&1
sleep 1
echo "kairos.test: class idle $(latency)"
service start crunch >/dev/null 2>&1
sleep 1
echo "kairos.test: class batch $(latency)"
# Out-of-memory scores (0 to about 1333; a process holding little memory
# is near 666): one of crunch's processes and the probe service's, while
# crunch is batch, and again while it is LC. The process the kernel kills
# when memory runs out is the one with the highest score.
oomscore() {
	cat "/proc/$1/oom_score" 2>/dev/null || echo none
}
oom() {
	set -- $(head -n 1 "$crunchg/cgroup.procs") $(pidof probe)
	echo "$(oomscore "$1") lc $(oomscore "$2")"
}
echo "kairos.test: oom batch $(oom)"
echo lc >"$crunchg/kairos.class" 2>/dev/null
echo "kairos.test: class lc $(latency)"
echo "kairos.test: oom relabelled $(oom)"
echo inherit >"$crunchg/kairos.class" 2>/dev/null

# Moving a service to the other class's group still works: change its
# description and start it again. Its new group below lc takes lc's class.
crunch=/etc/kairos/services/crunch
service stop crunch >/dev/null 2>&1
sed -i 's/^class .*/class lc/' $crunch
service start crunch >/dev/null 2>&1
echo "kairos.test: kclass lc/crunch $(kclass lc/crunch) $(procs lc/crunch)"
service stop crunch >/dev/null 2>&1
sed -i 's/^class .*/class batch/' $crunch

# Restart. Kill the scheduler's loader outright, as a crash would. Init
# should start a new one. Wait up to 20 s for a new loader with the
# scheduler running, and say how long it took, who started it, and how many
# times a scheduler was enabled meanwhile (the kernel counts enables): 0 if
# the scheduler outlived its loader, held by its pin; 1 if the kernel
# unloaded it with the loader and the new loader loaded it again.
old=$(pidof scx_kairos)
new=
if [ -n "$old" ]; then
	seq=$(cat /sys/kernel/sched_ext/enable_seq)
	kill -9 "$old"
	tenths=0
	while [ $tenths -lt 200 ]; do
		sleep 0.1
		tenths=$((tenths + 1))
		new=$(pidof scx_kairos)
		if [ -n "$new" ] && [ "$new" != "$old" ] &&
			[ "$(cat /sys/kernel/sched_ext/state)" = enabled ]; then
			break
		fi
		new=
	done
fi
if [ -n "$new" ]; then
	set -- $(sed 's/^.*) //' "/proc/$new/stat")
	reloads=$(($(cat /sys/kernel/sched_ext/enable_seq) - seq))
	echo "kairos.test: restart $((tenths / 10)).$((tenths % 10)) s parent $2 reloads $reloads"
else
	echo "kairos.test: restart none"
fi

# Shutdown. This leaves a program running after the script has ended. When
# the system shuts down, init should ask it to finish (the TERM signal) and
# give it time, and not cut the power under it. The program says when it is
# asked.
#
# When this script ends, the kernel hangs up its terminal: programs still
# using it get the HUP signal and can't write to it any more. So the program
# ignores HUP, which it inherits from here, and writes to the console.
#
# The script ends right after this, and the shutdown follows at once. So it
# waits until the program has said, by making a file, that it is ready for
# the signal.
trap '' HUP
(
	trap 'echo "kairos.test: shutdown asked"; exit 0' TERM
	: >/selftest.ready
	while :; do sleep 1; done
) </dev/null >/dev/console 2>&1 &
while [ ! -e /selftest.ready ]; do sleep 0.1; done

echo "kairos.test: done"
# Init powers the system off when this script ends.
